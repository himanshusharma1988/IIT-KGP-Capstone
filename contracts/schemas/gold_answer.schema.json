{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verisheet.local/contracts/gold_answer.schema.json",
  "title": "GoldAnswer",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "workbook_sha256", "must_refuse"],
  "properties": {
    "id": {"type": "string"},
    "workbook_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "gold_value": {},
    "gold_table_file": {"type": ["string", "null"]},
    "accepted_charts": {"type": "array", "items": {"type": "string"}},
    "must_refuse": {"type": "boolean"},
    "gold_script": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  }
}
